# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/

# pnpm's content-addressable store, when it lands inside the repository rather
# than in the user profile — which happens whenever pnpm runs in a container with
# the repo bind-mounted. Thousands of files, all regenerable, none belonging here.
# Note this is the store, NOT pnpm-lock.yaml: the lockfile is tracked deliberately
# and must stay that way, so no broad `pnpm*` rule is used.
.pnpm-store/

# next.js — the app lives in frontend/
.next/
out/
build/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Design-tool exports and scratch state
_ds/
.thumbnail
*.dc.html
support.js

# Editor / OS
.DS_Store
Thumbs.db

CLAUDE.md

ENGINEERING_NOTEBOOK.md
docs/rules.md
futurextensions.md


# ---------------------------------------------------------------------------
# CodeAtlas — environment configuration
# Copy this file to `.env.local` and fill in your own values.
#   cp .env.example .env.local
# Never commit `.env.local`; it is gitignored.
# ---------------------------------------------------------------------------

# --- AI provider -----------------------------------------------------------
# Google Gemini API key used by the CodeAtlas answering pipeline.
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Optional second key. CodeAtlas transparently falls back to it when the
# primary key is rate-limited or errors.
GEMINI_API_KEY_SECONDARY=

# --- GitHub ----------------------------------------------------------------
# Personal access token (read-only, public_repo scope is enough) used for
# repository metadata and file reads. Raises the GitHub API rate limit.
GITHUB_TOKEN=your_github_token

# --- Ingestion service -----------------------------------------------------
# Base URL of the CodeAtlas ingestion service (the FastAPI app in
# `gitingest-api/`). Local default: http://localhost:8000
GITINGEST_API_URL=http://localhost:8000

# --- Cache & rate limiting -------------------------------------------------
# Redis connection string. Backs both the repository cache and the per-IP
# daily AI request limit.
REDIS_URL=redis://localhost:6379

# --- Application -----------------------------------------------------------
# Public base URL of this CodeAtlas deployment. Used for server-to-server
# calls between route handlers.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional integrations -------------------------------------------------
# Supabase (currently unused by the shipped feature set; reserved for the
# persistence work described in docs/ENGINEERING_NOTEBOOK.md).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Show your own CodeAtlas fork's star count in the assistant header.
# Leave blank to hide the widget.
NEXT_PUBLIC_CODEATLAS_REPO_OWNER=
NEXT_PUBLIC_CODEATLAS_REPO_NAME=

# Rybbit analytics site ID. Leave blank to disable analytics entirely.
NEXT_PUBLIC_RYBBIT_SITE_ID=

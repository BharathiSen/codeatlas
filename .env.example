# ---------------------------------------------------------------------------
# CodeAtlas — environment configuration
# Copy this file to `.env.local` and fill in your own values.
#   cp .env.example .env.local
# Never commit `.env.local`; it is gitignored.
# ---------------------------------------------------------------------------

# --- AI provider -----------------------------------------------------------
# Google Gemini API key used by the CodeAtlas answering pipeline.
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Optional second key. CodeAtlas transparently falls back to it when the
# primary key is rate-limited or errors.
GEMINI_API_KEY_SECONDARY=

# Model used for answering. Defaults to the rolling `gemini-flash-lite-latest`
# alias so a model retirement cannot break the assistant. Pin a specific version
# here only if you need reproducible output.
# List what your key can use:
#   https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY
GEMINI_MODEL=gemini-flash-lite-latest

# --- GitHub ----------------------------------------------------------------
# Personal access token used for repository metadata and file reads.
#
# Create a CLASSIC token with NO SCOPES TICKED. CodeAtlas only reads public
# repositories, which requires no scope — the token exists purely to raise the
# API rate limit from 60/hr to 5,000/hr. Do not grant `public_repo`: it confers
# WRITE access to your public repositories, which is never used.
#
# Format is validated: classic `ghp_` + 36 chars, or fine-grained
# `github_pat_` + 80 or more chars.
GITHUB_TOKEN=your_github_token

# --- Ingestion service -----------------------------------------------------
# Base URL of the CodeAtlas ingestion service (the FastAPI app in `backend/`).
# Local default: http://localhost:8000
GITINGEST_API_URL=http://localhost:8000

# --- Cache & rate limiting -------------------------------------------------
# Redis connection string. Backs both the repository cache and the daily AI
# request quota.
REDIS_URL=redis://localhost:6379

# Requests per day for an anonymous caller, keyed by address. Default: 20
AI_DAILY_LIMIT=20

# Requests per day for a signed-in user, keyed by GitHub account. Signing in is
# how a caller escapes the shared anonymous bucket. Default: 100
AI_USER_DAILY_LIMIT=100

# What to do when Redis is unreachable. Default (unset/false) is FAIL CLOSED:
# requests are refused rather than run without an enforceable quota. Set to
# "true" to stay available at the cost of unbounded spend during an outage.
RATE_LIMIT_FAIL_OPEN=false

# --- Accounts (optional) ---------------------------------------------------
# Sign-in is entirely optional: nothing in CodeAtlas is gated behind an account.
# It exists so a user gets a private request budget instead of sharing one with
# everyone behind the same address. Leave AUTH_GITHUB_ID unset and the sign-in
# control does not render at all.
#
# Create an OAuth app at https://github.com/settings/developers with the
# callback URL http://localhost:3001/api/auth/callback/github (swap in your
# real origin in production). Only the read:user scope is requested.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Signs the session cookie. Generate with: openssl rand -base64 32
# Required whenever the two values above are set.
AUTH_SECRET=

# Public origin, used to build OAuth callback URLs behind a proxy.
# AUTH_URL=https://codeatlas.example.com

# Auth.js refuses requests whose Host header it does not trust, because that
# header decides where the OAuth callback goes. Development trusts localhost
# automatically. In production, set this to "true" when running behind a proxy
# you control, or pin AUTH_URL above instead. Leaving both unset in production
# makes every /api/auth/* request fail.
# AUTH_TRUST_HOST=true

# --- Persistence (optional) -------------------------------------------------
# Postgres, used only for saved conversations. Leave unset and CodeAtlas behaves
# as it always has: a chat lives in the browser tab and vanishes with it. Nothing
# else depends on it — answering, retrieval and quota all work without a database.
#
# Local:
#   docker run -d --name codeatlas-postgres -p 5435:5432 \
#     -e POSTGRES_USER=codeatlas -e POSTGRES_PASSWORD=codeatlas \
#     -e POSTGRES_DB=codeatlas postgres:16-alpine
#   DATABASE_URL=postgres://codeatlas:codeatlas@localhost:5435/codeatlas
#
# Apply the schema after setting this:  cd frontend && pnpm db:migrate
DATABASE_URL=

# Connections per instance. Small on purpose: route handlers run concurrently and,
# on a serverless host, across many instances at once. Default: 5
DATABASE_POOL_MAX=5

# --- Cost controls ---------------------------------------------------------
# Largest repository CodeAtlas will attempt to ingest, in kilobytes. Refused up
# front rather than failing as a timeout or, worse, an out-of-memory kill that
# looks like a 502.
#
# Default: 10000 (10 MB) — sized for a 512 MB instance such as Render Free.
# Indexing briefly holds the flattened repository, its chunks and each in-flight
# embedding batch at once, so the ceiling that matters is memory, not what GitHub
# will serve. Was 150000 (150 MB), which no free instance could survive.
#
# On a larger instance raise this deliberately: it is a tier default, not a
# product limit.
MAX_REPO_SIZE_KB=10000

# Prompt budget in estimated tokens. This is a COST ceiling, not the model's
# context limit — lowering it lowers spend per question. Default: 250000
MAX_PROMPT_TOKENS=250000

# Conversation turns included with each question. Default: 8
MAX_HISTORY_TURNS=8

# --- Application -----------------------------------------------------------
# Public base URL of this CodeAtlas deployment. Used for server-to-server calls
# between route handlers, so it must match the port the server actually listens
# on — a mismatch makes cache warming fail silently rather than loudly.
#
# 3001 is the local development port (`pnpm dev` pins it). Docker Compose runs
# the app on 3000 and sets this itself, so leave this at the dev value.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# --- Optional integrations -------------------------------------------------
# Show your own CodeAtlas fork's star count in the assistant header.
# Leave blank to hide the widget.
NEXT_PUBLIC_CODEATLAS_REPO_OWNER=
NEXT_PUBLIC_CODEATLAS_REPO_NAME=

# Rybbit analytics site ID. Leave blank to disable analytics entirely.
NEXT_PUBLIC_RYBBIT_SITE_ID=

# --- Retrieval -------------------------------------------------------------
# Qdrant vector store. Local: docker run -d -p 6333:6333 qdrant/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=codeatlas_chunks

# API key for a managed Qdrant cluster. Leave EMPTY for a local container, which
# is unauthenticated. Required for Qdrant Cloud: without it every call is refused
# with a bare `403 Forbidden`, indexing fails, and answers silently fall back to
# whole-repository context — retrieval appears to be "off" rather than broken.
QDRANT_API_KEY=

# Which embedding provider to use.
#   gemini — hosted, 768-dim, better quality, costs money and rate-limits hard
#            enough that indexing a large repository on the free tier will not
#            complete.
#   local  — fastembed / bge-small on CPU, 384-dim, no quota and no network.
#            Slower per chunk but unbounded, which is what makes indexing a
#            large repository possible without a billing account.
#
# Vector width is a property of the provider. Changing provider means the
# existing collection is unusable — point QDRANT_COLLECTION at a new name or
# delete the old one. The service refuses to start on a mismatch rather than
# failing obscurely at search time.
EMBEDDING_PROVIDER=gemini

# Gemini provider
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Local provider (requires: pip install fastembed)
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Indexing throughput. Lower these if you hit 429s on a free-tier key.
EMBEDDING_BATCH_SIZE=8
EMBEDDING_BATCH_PAUSE=0.6

# Chunks requested per question, and how long to wait before falling back to
# whole-repository context.
RETRIEVAL_CHUNK_LIMIT=14
RETRIEVAL_TIMEOUT_MS=20000

# --- Service boundary ------------------------------------------------------
# Shared secret between the web app and the ingestion/retrieval service.
# /ingest/, /index/ and /search/ spend money (cloning, embeddings), so leaving
# this unset is only acceptable when the backend is unreachable from outside
# localhost. The backend logs a warning at startup when it is empty.
INGEST_SERVICE_TOKEN=

# Origins allowed to call the backend from a browser (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Number of trusted reverse proxies in front of the app. 0 (default) ignores
# X-Forwarded-For entirely, because that header is client-controllable and a
# spoofed value would mint a fresh quota. Set to 1 behind Vercel, Cloudflare or
# a single nginx; the client IP is then counted from the right-hand end.
TRUSTED_PROXY_HOPS=0

AUTH_GITHUB_ID=your_github_client_id
AUTH_GITHUB_SECRET=your_github_client_secret
AUTH_SECRET=your_auth_secret
